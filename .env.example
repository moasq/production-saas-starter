# ./setup.sh fills blank secrets locally and preserves existing values.
POSTGRES_USER=starter
POSTGRES_DB=starter
POSTGRES_PASSWORD=
APP_DATABASE_PASSWORD=
AUTH_DATABASE_PASSWORD=
BETTER_AUTH_SECRET=
AUTH_INTERNAL_SECRET=

# Local HTTP. See SETUP.md for a public domain with automatic HTTPS.
APP_BASE_URL=http://localhost:3000
SITE_ADDRESS=:80
BIND_ADDRESS=127.0.0.1
HTTP_PORT=3000
HTTPS_PORT=443
APP_ENV=DEV

# Local email inbox only. Set COMPOSE_PROFILES= and real SMTP settings in production.
COMPOSE_PROFILES=local
MAILPIT_PORT=8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Starter <starter@localhost.test>

# Optional. Core sign-in and team management do not require billing.
BILLING_ENABLED=false
POLAR_ENVIRONMENT=sandbox
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID=
