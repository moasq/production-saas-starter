# Run ./setup.sh to generate a private database password and start the app.
POSTGRES_USER=starter
POSTGRES_DB=starter
POSTGRES_PASSWORD=

# Local HTTP. See SETUP.md for a public domain with automatic HTTPS.
APP_BASE_URL=http://localhost:3000
SITE_ADDRESS=:80
BIND_ADDRESS=127.0.0.1
HTTP_PORT=3000
HTTPS_PORT=443
APP_ENV=DEV

# Configure these to enable real organization sign-in.
STYTCH_ENV=test
STYTCH_PROJECT_ID=
STYTCH_SECRET=

# Optional. Core sign-in and team management do not require billing.
BILLING_ENABLED=false
POLAR_ENVIRONMENT=sandbox
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID=
