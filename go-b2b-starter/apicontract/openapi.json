  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "better-auth.session_token",
        "description": "HttpOnly session cookie; production uses the secure cookie prefix. Go verifies current membership through the private auth bridge."
      }
    },
    "schemas": {
      "Role": {
        "type": "string",
        "enum": [
          "admin",
          "manager",
          "member"
        ]
      },
      "Success": {
        "type": "object",
        "properties": {
          "success": {
            "const": true,
            "type": "boolean"
          }
        },
        "required": [
          "success"
        ]
      },
      "Error": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "error": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "code": {
                "type": "string"
              },
              "success": {
                "type": "boolean"
              }
            },
            "required": [
              "error"
            ]
          },
          {
            "type": "object",
            "properties": {
              "error": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "code": {
                "type": "string"
              },
              "success": {
                "type": "boolean"
              }
            },
            "required": [
              "message"
            ]
          }
        ]
      },
      "NameInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          }
        },
        "required": [
          "name"
        ]
      },
      "RoleInput": {
        "type": "object",
        "properties": {
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "role"
        ]
      },
      "InviteInput": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "role_slug": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "email",
          "name"
        ]
      },
      "VerifyPaymentInput": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "session_id"
        ]
      },
      "Organization": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "slug"
        ]
      },
      "ProfileOrganization": {
        "type": "object",
        "properties": {
          "organization_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "const": "active"
          }
        },
        "required": [
          "organization_id",
          "name",
          "slug",
          "status"
        ]
      },
      "Profile": {
        "type": "object",
        "properties": {
          "member_id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Role"
            },
            "minItems": 1,
            "maxItems": 1
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "org:view",
                "org:manage"
              ]
            }
          },
          "email_verified": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "const": "active"
          },
          "organization": {
            "$ref": "#/components/schemas/ProfileOrganization"
          },
          "account_id": {
            "type": "integer"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "member_id",
          "email",
          "name",
          "roles",
          "permissions",
          "email_verified",
          "status",
          "organization",
          "account_id",
          "created_at",
          "updated_at"
        ]
      },
      "Member": {
        "type": "object",
        "properties": {
          "member_id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Role"
            },
            "minItems": 1,
            "maxItems": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "pending"
            ]
          },
          "email_verified": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "member_id",
          "email",
          "name",
          "roles",
          "status",
          "email_verified",
          "created_at",
          "updated_at"
        ]
      },
      "MemberList": {
        "type": "object",
        "properties": {
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Member"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "members",
          "total"
        ]
      },
      "InvitationResult": {
        "type": "object",
        "properties": {
          "member_id": {
            "type": "string"
          },
          "invite_sent": {
            "type": "boolean"
          }
        },
        "required": [
          "member_id",
          "invite_sent"
        ]
      },
      "DeliveryResult": {
        "type": "object",
        "properties": {
          "invite_sent": {
            "type": "boolean"
          }
        },
        "required": [
          "invite_sent"
        ]
      },
      "ProfileResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "$ref": "#/components/schemas/Profile"
          }
        },
        "required": [
          "success",
          "data"
        ]
      },
      "OrganizationResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "$ref": "#/components/schemas/Organization"
          }
        },
        "required": [
          "success",
          "data"
        ]
      },
      "MemberListResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "$ref": "#/components/schemas/MemberList"
          }
        },
        "required": [
          "success",
          "data"
        ]
      },
      "InvitationResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "$ref": "#/components/schemas/InvitationResult"
          }
        },
        "required": [
          "success",
          "data"
        ]
      },
      "DeliveryResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "$ref": "#/components/schemas/DeliveryResult"
          }
        },
        "required": [
          "success",
          "data"
        ]
      },
      "BillingStatus": {
        "type": "object",
        "properties": {
          "BillingEnabled": {
            "type": "boolean"
          },
          "OrganizationID": {
            "type": "integer"
          },
          "ExternalID": {
            "type": "string"
          },
          "HasActiveSubscription": {
            "type": "boolean"
          },
          "SubscriptionID": {
            "type": "string"
          },
          "SubscriptionStatus": {
            "type": "string"
          },
          "ProductID": {
            "type": "string"
          },
          "CurrentPeriodEnd": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "CancelAtPeriodEnd": {
            "type": "boolean"
          },
          "Reason": {
            "type": "string"
          },
          "CheckedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "BillingEnabled",
          "OrganizationID",
          "ExternalID",
          "HasActiveSubscription",
          "SubscriptionID",
          "SubscriptionStatus",
          "ProductID",
          "CurrentPeriodEnd",
          "CancelAtPeriodEnd",
          "Reason",
          "CheckedAt"
        ]
      }
    }
  }
}
