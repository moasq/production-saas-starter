{
  "openapi": "3.1.0",
  "info": {
    "title": "Starter business API",
    "version": "1.0.0",
    "description": "Go-owned tenant/business boundary. Identity, workspace selection and the private Better Auth bridge are separate Next.js contracts. Clients never select a tenant with an API parameter. Server mutations forward the public Origin and request-scoped session cookie."
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "paths": {
