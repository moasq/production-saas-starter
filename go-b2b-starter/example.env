# For host development: copy to app.env. Docker uses the root .env instead.
ENV=DEV
SERVER_ADDRESS=:8080
ALLOWED_ORIGINS=http://localhost:3000
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=starter
POSTGRES_USER=starter_app
POSTGRES_PASSWORD=
DB_SSL_MODE=disable
AUTH_BRIDGE_URL=http://localhost:3000
AUTH_INTERNAL_SECRET=
APP_BASE_URL=http://localhost:3000
BILLING_ENABLED=false
POLAR_ENVIRONMENT=sandbox
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID=
