# For host development: copy to app.env. Docker uses the root .env instead.
ENV=DEV
SERVER_ADDRESS=:8080
ALLOWED_ORIGINS=http://localhost:3000
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=starter
POSTGRES_USER=starter
POSTGRES_PASSWORD=
DB_SSL_MODE=disable
STYTCH_ENV=test
STYTCH_PROJECT_ID=
STYTCH_SECRET=
STYTCH_INVITE_REDIRECT_URL=http://localhost:3000/authenticate
STYTCH_LOGIN_REDIRECT_URL=http://localhost:3000/authenticate
BILLING_ENABLED=false
POLAR_ENVIRONMENT=sandbox
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID=
