{$SITE_ADDRESS::80} {
  encode zstd gzip
  @frontend_api path /api/auth/session /api/auth/session/* /api/health
  handle @frontend_api {
    reverse_proxy frontend:3000
  }
  handle /api/* {
    reverse_proxy backend:8080
  }
  handle /health {
    reverse_proxy backend:8080
  }
  handle {
    reverse_proxy frontend:3000
  }
}
