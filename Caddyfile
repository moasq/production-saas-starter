{$SITE_ADDRESS::80} {
  encode zstd gzip
  handle /internal/* {
    respond 404
  }
  @frontend_api path /api/identity/* /api/workspaces /api/workspaces/* /api/health
  handle @frontend_api {
    reverse_proxy frontend:3000
  }
  handle /api/* {
    reverse_proxy backend:8080
  }
  @backend_health path /health /livez /readyz
  handle @backend_health {
    reverse_proxy backend:8080
  }
  handle {
    reverse_proxy frontend:3000
  }
}
